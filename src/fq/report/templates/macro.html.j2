{% extends "base.html.j2" %}
{% block title %}Market yields &middot; Turning over the Rocks{% endblock %}
{% block header %}
<h1>Market yields</h1>
<p class="subtitle">Equity index earnings yields vs. 10-year sovereign bond yields, month by month.</p>
<nav class="page-sections">
  <a href="index.html">&larr; Back to the lists</a>{% if us %}<a href="#us">United States</a>{% endif %}{% if jp %}<a href="#japan">Japan</a>{% endif %}<a href="#notes">Method &amp; sources</a>
</nav>
{% endblock %}
{% block content %}

{% if us %}
<div class="card intro" id="us">
  <h2>United States: latest reading ({{ us.latest_date }})</h2>
  <ul class="fw-points">
    <li><strong>S&amp;P 500 Earnings Yield (TTM):</strong> {{ us.latest_ey }} (the inverse of the trailing 12-month P/E ratio).</li>
    <li><strong>10-Year US Treasury Yield:</strong> {{ us.latest_ty }} (month-end close of <code>^TNX</code>).</li>
    <li><strong>Yield Spread (Earnings Yield &minus; 10Y Treasury):</strong> <span class="{{ 'pos' if us.latest_spread_pos else 'neg' }}">{{ us.latest_spread }}</span> &middot; {{ us.start_date }}&ndash;present median: {{ us.median_spread }} (range: {{ us.min_spread }} to {{ us.max_spread }} across {{ us.n_months }} months).</li>
    {% if us.has_cagr %}
    <li><strong>Next 3Y Annualized Total Return (through {{ us.cagr_end_date }} start):</strong> <span class="{{ 'pos' if us.latest_cagr_pos else 'neg' }}">{{ us.latest_cagr }}</span> &middot; historical median: {{ us.median_cagr }} (range: {{ us.min_cagr }} to {{ us.max_cagr }}).</li>
    {% endif %}
  </ul>
</div>

<section class="card chart-card">
  <h2>S&amp;P 500 Earnings Yield vs. 10-Year Treasury Yield ({{ us.start_date }} &ndash; {{ us.latest_date }})</h2>
  <p class="meta">{{ us.n_months }} monthly observations &middot; top: yields (%) &middot; bottom: spread (pp, left axis) &amp; next 3Y annualized total return (%/yr, right axis)</p>
  <div class="company-chart">{{ us.chart | safe }}</div>
  <p class="chart-instruction">Use the range buttons (5Y, 10Y, 20Y, All) or drag to zoom. In the lower panel, the teal line shows the yield spread (Earnings Yield &minus; 10Y Treasury, left axis) and the green/red bars show the realized 3-year annualized total return starting from that month (right axis).</p>
</section>
{% endif %}

{% if jp %}
<div class="card intro" id="japan">
  <h2>Japan: latest reading ({{ jp.latest_date }})</h2>
  <ul class="fw-points">
    <li><strong>TSE Prime / 1st Section Earnings Yield:</strong> {{ jp.latest_ey }} (inverse of JPX consolidated market-cap weighted average PER).</li>
    <li><strong>10-Year JGB Yield:</strong> {{ jp.latest_ty }} (month-end 10Y JGB rate from Japan's Ministry of Finance).</li>
    <li><strong>Yield Spread (Earnings Yield &minus; 10Y JGB):</strong> <span class="{{ 'pos' if jp.latest_spread_pos else 'neg' }}">{{ jp.latest_spread }}</span> &middot; {{ jp.start_date }}&ndash;present median: {{ jp.median_spread }} (range: {{ jp.min_spread }} to {{ jp.max_spread }} across {{ jp.n_months }} months).</li>
    {% if jp.has_cagr %}
    <li><strong>Next 3Y Annualized Total Return (through {{ jp.cagr_end_date }} start):</strong> <span class="{{ 'pos' if jp.latest_cagr_pos else 'neg' }}">{{ jp.latest_cagr }}</span> &middot; historical median: {{ jp.median_cagr }} (range: {{ jp.min_cagr }} to {{ jp.max_cagr }}).</li>
    {% endif %}
  </ul>
</div>

<section class="card chart-card">
  <h2>Japan TSE Earnings Yield vs. 10-Year JGB Yield ({{ jp.start_date }} &ndash; {{ jp.latest_date }})</h2>
  <p class="meta">{{ jp.n_months }} monthly observations &middot; top: yields (%) &middot; bottom: spread (pp, left axis) &amp; next 3Y annualized total return (%/yr, right axis)</p>
  <div class="company-chart">{{ jp.chart | safe }}</div>
  <p class="chart-instruction">Use the range buttons (5Y, 10Y, 20Y, All) or drag to zoom. Reflects TSE 1st Section non-consolidated average (1974&ndash;1998), consolidated average (1999&ndash;2012), consolidated weighted average (2013&ndash;Mar 2022), and TSE Prime consolidated weighted average (Apr 2022 onward), alongside the subsequent 3-year annualized total return bars on the right axis.</p>
</section>
{% endif %}

<div class="card" id="notes">
  <h2>Method &amp; sources</h2>
  <ul class="plain-points">
    {% if us %}
    <li><strong>US 10-Year Treasury Yield:</strong> Monthly month-end close of CBOE 10-Year Treasury Note Yield (<code>^TNX</code>) via Yahoo Finance (1962&ndash;present), backfilled for 1960&ndash;1961 from FRED 10-Year Treasury Constant Maturity Rate (<code>GS10</code>).</li>
    <li><strong>S&amp;P 500 Earnings Yield:</strong> Monthly trailing 12-month (TTM) earnings yield from <a href="https://www.multpl.com/s-p-500-earnings-yield/table/by-month" target="_blank" rel="noopener">Multpl</a> (as-reported S&amp;P 500 earnings divided by index price), clipped at January 1960.</li>
    <li><strong>US Next 3Y Annualized Total Return:</strong> Forward 36-month compound annual growth rate (<code>(TR[t+36] / TR[t])^(1/3) &minus; 1</code>) computed from Yahoo Finance's S&amp;P 500 Total Return Index (<code>^SP500TR</code>, 1988&ndash;present), spliced for 1960&ndash;1987 with monthly <code>^GSPC</code> price returns plus Multpl trailing S&amp;P 500 dividend yields.</li>
    {% endif %}
    {% if jp %}
    <li><strong>Japan 10-Year JGB Yield:</strong> Official daily 10-year JGB yields from Japan's <a href="https://www.mof.go.jp/english/policy/jgbs/reference/interest_rate/index.htm" target="_blank" rel="noopener">Ministry of Finance</a> (<code>jgbcme_all.csv</code>), resampled to month-end.</li>
    <li><strong>Japan Equity Earnings Yield:</strong> Inverse (<code>100 / PER</code>) of official <a href="https://www.jpx.co.jp/english/markets/statistics-equities/misc/04.html" target="_blank" rel="noopener">JPX</a> TSE 1st Section / Prime PER series: non-consolidated simple average (1974&ndash;1998), consolidated simple average (1999&ndash;2012), and consolidated market-cap weighted average (2013 onward).</li>
    <li><strong>Japan Next 3Y Annualized Total Return:</strong> Forward 36-month compound annual growth rate computed from Yahoo Finance's iShares Core TOPIX ETF adjusted close (<code>1305.T</code>, 2008&ndash;present), spliced for 1986&ndash;2007 with FRED's OECD Japan All-Shares index (<code>SPASTT01JPM661N</code>) and JPX TSE 1st Section / Prime average dividend yields.</li>
    {% endif %}
  </ul>
</div>

{% endblock %}
